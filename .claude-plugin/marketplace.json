{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "engineering-lens-tools",
  "description": "Source marketplace for the Engineering Lens workflows.",
  "owner": {
    "name": "Bartosz Cichecki"
  },
  "plugins": [
